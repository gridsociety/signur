# Signur runs with no configuration at all: every value below has a working
# default. Copy this file to .env only when you want to change something.

# --- Storage -----------------------------------------------------------------
# SQLite by default. Point this at PostgreSQL for multi-user deployments:
# postgresql+psycopg://signur:password@127.0.0.1:5432/signur
# SIGNUR_DATABASE_URL=sqlite+pysqlite:///./var/signur.db
# SIGNUR_STORAGE_ROOT=./var/blobs

# --- Server ------------------------------------------------------------------
# SIGNUR_BIND_HOST=127.0.0.1
# SIGNUR_BIND_PORT=8000
# Apply pending database migrations on startup.
# SIGNUR_AUTO_MIGRATE=true

# --- Authentication ----------------------------------------------------------
# "standalone" (default) runs single-user: no login, one local administrator.
# "forward_auth" trusts identity headers injected by an authenticating reverse
# proxy, and is only safe when the backend accepts traffic from that proxy only.
# SIGNUR_AUTH_MODE=standalone
# SIGNUR_STANDALONE_DISPLAY_NAME=Amministratore

# Everything below applies to forward_auth only.
# SIGNUR_IDENTITY_AUTHORITY=https://auth.example.org/application/o/signur/
# SIGNUR_ALLOWED_ORIGINS=https://signur.example.org
# Header names vary by proxy; these are the defaults.
# SIGNUR_IDENTITY_UID_HEADER=X-Auth-Uid
# SIGNUR_IDENTITY_USERNAME_HEADER=X-Auth-Username
# SIGNUR_IDENTITY_NAME_HEADER=X-Auth-Name
# SIGNUR_IDENTITY_EMAIL_HEADER=X-Auth-Email
# Optional shared secret the proxy injects as defence in depth.
# SIGNUR_FORWARD_AUTH_SHARED_SECRET=
# Comma-separated source IPs allowed to reach the backend; empty disables it.
# SIGNUR_TRUSTED_GATEWAY_IPS=

# --- Signing -----------------------------------------------------------------
# SIGNUR_MAX_UPLOAD_BYTES=33554432
# Only used by the PKCS11 Web Proxy backend.
# SIGNUR_SIGNING_PROXY_URL=http://127.0.0.1:9021
# SIGNUR_SIGNING_PROXY_TIMEOUT_SECONDS=30
# Required for ANY signature made with a local PKCS#11 middleware: the PIN is
# encrypted both when saved on a certificate and when queued for a single
# signature. At least 32 characters. Without it, local signing fails.
# SIGNUR_PIN_ENCRYPTION_KEY=
