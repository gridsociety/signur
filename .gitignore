# macOS
.DS_Store
.AppleDouble
.LSOverride

# Environment variables and local secrets
.env
.env.*
!.env.example
!.env.*.example

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/

# Python virtual environments
.venv/
venv/
env/
ENV/

# Packaging and build artifacts
build/
!src/signur/static/vendor/pdfjs/build/
!src/signur/static/vendor/pdfjs/build/*.mjs
dist/
*.egg-info/
.eggs/

# Test and coverage output
.coverage
.coverage.*
htmlcov/
coverage.xml
junit.xml

# Editors and IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# Local runtime files
*.log
*.pid
*.sqlite
*.sqlite3

# Development documentation and planning: internal material that must not
# reach the public repository
docs/
plans/
specs/
notes/
design/
